{
  "name": "cloudscope-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare": "node scripts/installGitHooks.mjs",
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "check": "npm run format:check && npm run lint && npm run verify:samples && npm test && npm run build && npm run verify:dist",
    "verify:samples": "node --experimental-strip-types scripts/verifySamples.ts",
    "verify:dist": "node --experimental-strip-types scripts/verifySamples.ts --dist",
    "test": "vitest run",
    "typecheck": "vue-tsc --build --force",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "numcodecs": "^0.3.2",
    "papaparse": "^5.6.0",
    "plotly.js-dist-min": "^3.7.0",
    "vue": "^3.5.41",
    "zarrita": "^0.7.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^26.2.0",
    "@types/papaparse": "^5.5.2",
    "@types/plotly.js": "^3.0.13",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "sirv": "^3.0.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  }
}
